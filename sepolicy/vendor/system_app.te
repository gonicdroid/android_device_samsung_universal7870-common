allow system_app sysfs_mdnie:{ file lnk_file } rw_file_perms;
allow system_app sysfs_mdnie:dir search;
allow system_app sysfs_graphics:dir search;
allow system_app sysfs_graphics:file rw_file_perms;
allow system_app wificond:binder call;

# IMS Service (runs in system_app domain)
binder_call(system_app, rild)
allow system_app sec_radio_hwservice:hwservice_manager find;
dontaudit system_app net_dns_prop:file r_file_perms;

# Suppress harmless proc access & service lookups from Settings
dontaudit system_app proc_pagetypeinfo:file r_file_perms;
dontaudit system_app {
    apex_service
    system_suspend_control_service
}:service_manager find;
