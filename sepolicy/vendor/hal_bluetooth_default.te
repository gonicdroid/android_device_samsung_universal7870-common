# /dev/ttySAC*
allow hal_bluetooth_default bluetooth_device:chr_file rw_file_perms;

# /efs
allow hal_bluetooth_default efs_file:dir search;
allow hal_bluetooth_default efs_file:file r_file_perms;
r_dir_file(hal_bluetooth_default, bluetooth_efs_file)

# sysfs rfkill
allow hal_bluetooth_default sysfs_bluetooth_writable:file rw_file_perms;
allow hal_bluetooth_default sysfs:file rw_file_perms;

# Vendor binder
vndbinder_use(hal_bluetooth_default)
