+/*******************************************************************************
+**
+** Function         hw_pcm_pin_cfg_cback
+**
+** Description      Callback function for PCM pin configuration request
+**
+** Returns          None
+**
+*******************************************************************************/
+static void hw_pcm_pin_cfg_cback(void *p_mem)
+{
+    HC_BT_HDR   *p_evt_buf = (HC_BT_HDR *)p_mem;
+    uint8_t     status = *((uint8_t *)(p_evt_buf + 1) + HCI_EVT_CMD_CMPL_STATUS_RET_BYTE);
+
+    if (status != 0)
+    {
+        ALOGE("hw_pcm_pin_cfg failed with status 0x%02x", status);
+    }
+    else
+    {
+        ALOGI("hw_pcm_pin_cfg success");
+    }
+
+    /* Free the RX event buffer */
+    if (bt_vendor_cbacks)
+    {
+        bt_vendor_cbacks->dealloc(p_evt_buf);
+#if (BTHW_FW_EXTENDED_CONFIGURATION == TRUE)
+        bt_vendor_cbacks->fwcfg_cb(status == 0 ? BT_VND_OP_RESULT_SUCCESS : BT_VND_OP_RESULT_FAIL);
+        bt_vendor_cbacks->scocfg_cb(status == 0 ? BT_VND_OP_RESULT_SUCCESS : BT_VND_OP_RESULT_FAIL);
+#endif
+        bt_vendor_cbacks->audio_state_cb(status == 0 ? BT_VND_OP_RESULT_SUCCESS : BT_VND_OP_RESULT_FAIL);
+    }
+}
+
+/*******************************************************************************
+**
+** Function         hw_pcm_pin_cfg
+**
+** Description      Configure Broadcom PCM physical pins (VSC 0xFC61)
+**
+** Returns          0: Success, -1: Fail
+**
+*******************************************************************************/
+int hw_pcm_pin_cfg(uint8_t enable)
+{
+    HC_BT_HDR *p_buf = NULL;
+    uint8_t *p;
+    uint8_t ret;
+    uint16_t cmd_u16 = HCI_CMD_PREAMBLE_SIZE + PCM_PINS_PARAM_SIZE;
+
+    ALOGI("hw_pcm_pin_cfg: enable=%d", enable);
+
+    if (bt_vendor_cbacks)
+        p_buf = (HC_BT_HDR *)bt_vendor_cbacks->alloc(BT_HC_HDR_SIZE + cmd_u16);
+
+    if (p_buf)
+    {
+        p_buf->event = MSG_STACK_TO_HC_HCI_CMD;
+        p_buf->offset = 0;
+        p_buf->layer_specific = 0;
+        p_buf->len = cmd_u16;
+
+        p = (uint8_t *)(p_buf + 1);
+        UINT16_TO_STREAM(p, HCI_VSC_SET_PCM_PINS);
+        *p++ = PCM_PINS_PARAM_SIZE;
+
+        if (enable)
+        {
+            *p++ = 0x01;
+            *p++ = 0xb9;
+            *p++ = 0xb8;
+            *p++ = 0xb9;
+            *p++ = 0xb9;
+        }
+        else
+        {
+            *p++ = 0x00;
+            *p++ = 0xb9;
+            *p++ = 0xb8;
+            *p++ = 0xb8;
+            *p++ = 0xb8;
+        }
+
+        if ((ret = bt_vendor_cbacks->xmit_cb(HCI_VSC_SET_PCM_PINS, p_buf, hw_pcm_pin_cfg_cback)) == FALSE)
+        {
+            ALOGE("hw_pcm_pin_cfg: xmit_cb failed");
+            bt_vendor_cbacks->dealloc(p_buf);
+            return -1;
+        }
+        return 0;
+    }
+    return -1;
+}
