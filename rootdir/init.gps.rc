on post-fs-data
    # Directory for GPS
    mkdir /data/vendor/gps 0771 gps system
    chown gps system /data/vendor/gps
    chmod 0771 /data/vendor/gps
    mkdir /data/vendor/gps/sgee 0771 gps system
    chown gps system /data/vendor/gps/sgee
    chmod 0771 /data/vendor/gps/sgee
    rm /data/vendor/gps/gps_started
    rm /data/vendor/gps/glonass_started
    rm /data/vendor/gps/beidou_started
    rm /data/vendor/gps/smd_started
    rm /data/vendor/gps/sv_cno.info
    # Permissions for gnss
    chmod 0660 /dev/gnss_ipc
    chown gps system /dev/gnss_ipc

# GPS
service gpsd /vendor/bin/hw/gpsd -c /vendor/etc/gnss/gps.cfg
    class main
    user gps
    group system gps inet net_raw wakelock
    capabilities BLOCK_SUSPEND
    ioprio be 0